# Kopieer dit bestand naar .env en vul het in. .env staat in .gitignore.
# Nooit committen, nooit in chat plakken.
FTP_PROTO=ftps            # ftps of sftp (ftp alleen met FTP_ALLOW_PLAINTEXT=yes; onversleuteld!)
FTP_HOST=ftp.voorbeeld.nl
# FTP_PORT=21
FTP_USER=gebruikersnaam
FTP_PASS=wachtwoord
FTP_PATH=/domains/eboh.nl/public_html/wp-content/themes/eboh-theme-v2
SITE_URL=https://www.eboh.nl   # voor de controle na de upload
